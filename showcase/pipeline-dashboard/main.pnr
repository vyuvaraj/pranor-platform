// Servverse Pipeline Status Dashboard - Written in Serv-lang (V2 - SafeMap Resolved)
// Demonstrates: HTTP routes, direct HTML rendering, SQLite persistence, background polling
// Run locally: pranor run main.pnr --watch

server "9000"
database "sqlite://pipeline.db"
cache "in-memory"

// --- Database Schema Setup ---
migration "create_pipelines_table" {
    db.query("CREATE TABLE IF NOT EXISTS pipelines (
        repo TEXT PRIMARY KEY,
        status TEXT NOT NULL,
        run_number TEXT,
        author TEXT,
        url TEXT,
        updated_at TEXT
    )")
}

// --- Seed Mock Data on Startup ---
every 1h {
    // Seed initial values so the dashboard has data immediately
    log.info("[Pipeline Daemon] Updating pipeline cache...")
    
    let repos = ["ServGate", "ServConsole", "ServStore", "ServQueue", "ServAuth", "ServPool", "ServTrace", "Serv-lang", "servverse-ee", "ServMesh", "ServCron", "ServCache", "ServDocs", "ServMail", "ServRegistry"]
    for r in repos {
        // Query database to see if it exists
        let exists = db.query("SELECT repo FROM pipelines WHERE repo = ?", r)
        if exists == nil {
            let mockStatus = "success"
            if r == "servverse-ee" {
                mockStatus = "success"
            }
            db.query("INSERT INTO pipelines (repo, status, run_number, author, url, updated_at) VALUES (?, ?, ?, ?, ?, datetime('now'))", 
                r, mockStatus, "142", "vyuvaraj", "https://github.com/vyuvaraj/" + r + "/actions", "datetime('now')")
        }
    }
}

// --- Live GitHub API Polling ---
every 5m {
    log.info("[Pipeline Daemon] Polling GitHub Actions API for pipeline updates...")
    
    let repos = ["ServGate", "ServConsole", "ServStore", "ServQueue", "ServAuth", "ServPool", "ServTrace", "Serv-lang", "servverse-ee", "ServMesh", "ServCron", "ServCache", "ServDocs", "ServMail", "ServRegistry"]
    for r in repos {
        let apiURL = "https://api.github.com/repos/vyuvaraj/" + r + "/actions/runs?per_page=1"
        
        let headers = {}
        let token = env("GITHUB_TOKEN")
        if token != nil {
            headers = { "Authorization": "Bearer " + token }
        } else {
            let pat = env("GITHUB_PAT")
            if pat != nil {
                headers = { "Authorization": "token " + pat }
            }
        }
        
        // Use http.get directly with custom headers
        let res = http.get(apiURL, headers)
        if res.status == 200 {
            let data = json.parse(res.body)
            if data != nil {
                let runs = data.workflow_runs
                if runs != nil {
                    if runs.length() > 0 {
                        let latestRun = runs[0]
                        let statusVal = latestRun.conclusion
                        if statusVal == nil {
                            statusVal = latestRun.status
                        }
                        let runNum = latestRun.run_number
                        let authorVal = latestRun.triggering_actor.login
                        let runURL = latestRun.html_url
                        
                        db.query("INSERT OR REPLACE INTO pipelines (repo, status, run_number, author, url, updated_at) VALUES (?, ?, ?, ?, ?, datetime('now'))",
                            r, statusVal, "" + runNum, authorVal, runURL)
                        log.info("Updated status for " + r + ": " + statusVal)
                    }
                }
            }
        } else {
            log.warn("Failed to fetch GitHub Action status for " + r + ", using current database state.")
        }
    }
}

// --- Web Dashboard Route ---
export route "GET" "/" (req) {
    let rows = db.query("SELECT * FROM pipelines ORDER BY CASE WHEN status = 'failure' OR status = 'failed' THEN 1 WHEN status = 'in_progress' OR status = 'queued' THEN 2 WHEN status = 'success' THEN 3 ELSE 4 END ASC, repo ASC")
    
    // Fallback if DB is querying mid-setup
    if rows == nil {
        rows = []
    }
    
    // Define raw HTML template using standard go templates
    let tpl = `<!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Servverse CI/CD Pipeline Dashboard</title>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
        <style>
            :root {
                --primary: #6366f1;
                --primary-glow: rgba(99, 102, 241, 0.15);
                --bg: #090a0f;
                --card-bg: rgba(255, 255, 255, 0.03);
                --card-border: rgba(255, 255, 255, 0.05);
                --text: #f3f4f6;
                --text-muted: #9ca3af;
                --success: #10b981;
                --failed: #ef4444;
                --running: #f59e0b;
            }
            
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }
            
            body {
                font-family: 'Outfit', sans-serif;
                background-color: var(--bg);
                color: var(--text);
                min-height: 100vh;
                background-image: 
                    radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.05) 0%, transparent 40%),
                    radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.03) 0%, transparent 45%);
                padding: 2rem;
            }
            
            .container {
                max-width: 1200px;
                margin: 0 auto;
            }
            
            header {
                text-align: center;
                margin-bottom: 3rem;
            }
            
            h1 {
                font-size: 2.8rem;
                font-weight: 800;
                background: linear-gradient(135deg, #fff 30%, var(--primary) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                margin-bottom: 0.5rem;
                letter-spacing: -0.05em;
            }
            
            .subtitle {
                color: var(--text-muted);
                font-size: 1.1rem;
            }
            
            .grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
                gap: 1.5rem;
            }
            
            .card {
                background: var(--card-bg);
                border: 1px solid var(--card-border);
                border-radius: 16px;
                padding: 1.5rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                backdrop-filter: blur(12px);
                transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
                position: relative;
                overflow: hidden;
            }
            
            .card:hover {
                transform: translateY(-4px);
                border-color: rgba(99, 102, 241, 0.2);
                box-shadow: 0 12px 30px var(--primary-glow);
            }
            
            .card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, var(--primary), transparent);
                opacity: 0;
                transition: opacity 0.2s;
            }
            
            .card:hover::before {
                opacity: 1;
            }
            
            .card-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.5rem;
            }
            
            .repo-name {
                font-size: 1.4rem;
                font-weight: 600;
                letter-spacing: -0.02em;
            }
            
            .badge {
                padding: 0.35rem 0.75rem;
                border-radius: 99px;
                font-size: 0.85rem;
                font-weight: 600;
                text-transform: uppercase;
                display: inline-flex;
                align-items: center;
                gap: 0.3rem;
            }
            
            .status-success {
                background: rgba(16, 185, 129, 0.1);
                color: var(--success);
                border: 1px solid rgba(16, 185, 129, 0.2);
            }
            
            .status-failed {
                background: rgba(239, 68, 68, 0.1);
                color: var(--failed);
                border: 1px solid rgba(239, 68, 68, 0.2);
            }
            
            .status-running {
                background: rgba(245, 158, 11, 0.1);
                color: var(--running);
                border: 1px solid rgba(245, 158, 11, 0.2);
                animation: pulse 2s infinite;
            }
            
            @keyframes pulse {
                0% { opacity: 1; }
                50% { opacity: 0.6; }
                100% { opacity: 1; }
            }
            
            .card-body {
                margin-bottom: 1.5rem;
                font-size: 0.95rem;
                color: var(--text-muted);
                line-height: 1.6;
            }
            
            .card-body p {
                margin-bottom: 0.4rem;
            }
            
            .card-body strong {
                color: var(--text);
            }
            
            .card-footer {
                margin-top: auto;
            }
            
            .btn {
                display: block;
                width: 100%;
                text-align: center;
                padding: 0.75rem;
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid var(--card-border);
                border-radius: 10px;
                color: var(--text);
                text-decoration: none;
                font-weight: 600;
                transition: background 0.2s, border-color 0.2s;
            }
            
            .btn:hover {
                background: var(--primary);
                border-color: var(--primary);
                box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
            }
        </style>
        <script>
            setTimeout(function(){
                window.location.reload();
            }, 15000);
        </script>
    </head>
    <body>
        <div class="container">
            <header>
                <h1>Servverse Pipeline Monitor</h1>
                <p class="subtitle">Real-time status of 15 ecosystem modules powered by Serv-lang</p>
            </header>
            
            <div class="grid">
                {{ range .pipelines }}
                <div class="card">
                    <div class="card-header">
                        <span class="repo-name">{{ .repo }}</span>
                        {{ if or (eq .status "failure") (eq .status "failed") }}
                        <span class="badge status-failed">✗ {{ .status }}</span>
                        {{ else if or (eq .status "in_progress") (eq .status "queued") }}
                        <span class="badge status-running">⟳ {{ .status }}</span>
                        {{ else }}
                        <span class="badge status-success">✓ {{ .status }}</span>
                        {{ end }}
                    </div>
                    <div class="card-body">
                        <p><strong>Run:</strong> #{{ .run_number }}</p>
                        <p><strong>Triggered By:</strong> {{ .author }}</p>
                        <p><strong>Last Updated:</strong> {{ .updated_at }}</p>
                    </div>
                    <div class="card-footer">
                        <a href="{{ .url }}" target="_blank" class="btn">View Actions Workflow</a>
                    </div>
                </div>
                {{ end }}
            </div>
        </div>
    </body>
    </html>`
    
    return html.template(tpl, { "pipelines": rows })
}
